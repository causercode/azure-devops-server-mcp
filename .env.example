# Server root / virtual directory, WITHOUT the collection or project suffix.
ADO_SERVER_URL=https://devops.example.com/tfs
ADO_COLLECTION=DefaultCollection

# Optional: omit to discover projects with server_info/action=list_projects.
# ADO_PROJECT=MyProject

# Explicit repository access, using project/repository names or IDs. No wildcards.
# Omitted: reads follow ADO permissions, but ALL PR writes are disabled.
# Configured: ALL repository reads and writes are restricted to these entries.
# [] denies all repository access. IDs are recommended to preserve identity on rename.
# Replace [] with your own explicit entries before connecting.
ADO_ALLOWED_REPOSITORIES=[]
# ADO_ALLOWED_REPOSITORIES='[{"project":"MyProject","repository":"MyRepo"}]'

# Independent work-item permission. Omitted or [] denies all work-item reads/writes.
# Write projects must also resolve within the read list. Repository scope grants none.
# Prefer project GUIDs; a default project or PAT scope does not enable these features.
ADO_ALLOWED_WORK_ITEM_PROJECTS=[]
ADO_WORK_ITEM_WRITE_PROJECTS=[]
# ADO_ALLOWED_WORK_ITEM_PROJECTS='["MyProject"]'
# ADO_WORK_ITEM_WRITE_PROJECTS='["MyProject"]'
# Work Items Read for reads; Read & write for fields/comments/links.
# Reviewer person lookup additionally requires Identity Read.

# Queueing also requires both independent build scopes; defaults are deny-all.
# Review every approved classic definition for scripts, credentials and side effects.
ADO_BUILD_WRITE_REPOSITORIES=[]
ADO_BUILD_WRITE_DEFINITIONS=[]
# ADO_BUILD_WRITE_REPOSITORIES='[{"project":"MyProject","repository":"MyRepo"}]'
# ADO_BUILD_WRITE_DEFINITIONS=[42]

ADO_AUTH_TYPE=pat
# Supply a PAT to the MCP process. Never paste a real token into an agent prompt.
ADO_TOKEN=replace-with-your-personal-access-token
# Recommended instead of ADO_TOKEN: store the PAT in the OS credential store with
#   azure-devops-server-mcp auth set-token
# then remove ADO_TOKEN and set:
# ADO_TOKEN_SOURCE=credential-manager
# ADO_CREDENTIAL_TARGET=optional-custom-entry-name

# Alternative on a domain-joined machine: Windows integrated (Kerberos) sign-in.
# No PAT; the agent acts with your full identity. Remove ADO_TOKEN when using it.
# ADO_AUTH_TYPE=negotiate
# ADO_KERBEROS_SPN=HTTP/devops.example.com

# Base Server 2022 uses 7.0. Server 2022.1+ can use 7.1.
ADO_API_VERSION=7.0
# Per HTTP request, including response body reading (100–120000 ms).
ADO_TIMEOUT_MS=30000
